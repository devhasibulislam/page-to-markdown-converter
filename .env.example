# Copy to .env and fill in your own values. .env is committed in this repo
# because the maintainer prefers it that way; you may want to change that in
# your fork.

REDIS_URL=redis://user:password@localhost:6379/0
REDIS_KEY_PREFIX=page-to-md

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=your.email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_FROM_NAME=Page to Markdown
MAIL_FROM_ADDRESS=noreply@yourdomain.com
MAIL_STARTTLS=true

PUBLIC_BASE_URL=http://localhost:8000

JOB_TTL_SECONDS=3600
JOB_DIR=/tmp/page-to-md-jobs
